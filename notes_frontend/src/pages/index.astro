---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import NotesList from '../components/NotesList.astro';
import { getNotes } from '../services/api';

const notes = await getNotes();
---

<Layout>
  <Header />
  <NotesList notes={notes} />
</Layout>

<script>
  import { getNotes } from '../services/api';

  async function refresh(query) {
    try {
      const list = await getNotes(query);
      const container = document.getElementById('note-list');
      if (!container) return;
      if (list.length === 0) {
        container.innerHTML = '<div class="empty">No matching notes.</div>';
        return;
      }
      container.innerHTML = list.map((n) => `
        <article class="note-card" data-id="${n.id}">
          <h3><a href="/note/${n.id}">${n.title || 'Untitled'}</a></h3>
          <p>${(n.content || '').slice(0, 160)}</p>
          <div class="note-meta">
            <span>${new Date(n.updatedAt).toLocaleString()}</span>
            <div class="note-actions">
              <a class="btn" href="/note/${n.id}">Open</a>
              <a class="btn" href="/note/${n.id}/edit">Edit</a>
              <button class="btn warn" data-action="delete" data-id="${n.id}">Delete</button>
            </div>
          </div>
        </article>
      `).join('');
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('notes:search', (ev) => {
    const detail = ev.detail || {};
    const q = detail.query || '';
    refresh(q);
  });
</script>
